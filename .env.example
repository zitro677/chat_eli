# Agente ELI — Agua ELIM — Variables de entorno
# Copia este archivo como .env y llena tus datos. NUNCA subas .env a GitHub.

# ── OpenAI API ─────────────────────────────────────────────
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
# Modelo para el RAG (búsqueda en /knowledge)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Proveedor de WhatsApp (ycloud | meta) ─────────────────
WHATSAPP_PROVIDER=ycloud

# YCloud (si WHATSAPP_PROVIDER=ycloud)
YCLOUD_API_KEY=
YCLOUD_PHONE_NUMBER=+16154142526
# Secreto del endpoint de webhook en YCloud (Developers → Webhooks). Vacío = no se verifica firma
YCLOUD_WEBHOOK_SECRET=

# Meta Cloud API (si WHATSAPP_PROVIDER=meta — fase posterior)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=

# ── Make (leads y avisos de transferencia → Google Sheets) ──
MAKE_WEBHOOK_URL=

# ── Atención humana ───────────────────────────────────────
# Horas que el bot se queda callado cuando un asesor toma la conversación
HANDOFF_PAUSE_HOURS=8
BUSINESS_TIMEZONE=America/Chicago

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./elim.db
# Producción en el VPS (lo define docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://elim:CLAVE@db:5432/elim
POSTGRES_PASSWORD=
